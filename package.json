{
  "name": "freebuff-supervisor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "streak": "node scripts/streak-keeper.mjs",
    "streak:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-streak-task.ps1",
    "streak:unregister": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-streak-task.ps1 -Remove",
    "postinstall": "node scripts/patch-node-pty.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
